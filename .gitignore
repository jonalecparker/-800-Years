# Unity (standard ignores — ready for when the Unity project is created)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity crash/asset artifacts
sysinfo.txt
*.stackdump
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-build.properties

# IDE
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.user

# OS
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Claude's verification screenshots — working artifacts, not project
# assets. Wiped at each /wrap; the folder itself stays so captures have
# somewhere to land (Unity ignores dotfiles, so .gitkeep is invisible).
Assets/Screenshots/*
!Assets/Screenshots/.gitkeep

# Unity's recovery scratch folder
Assets/_Recovery/
Assets/_Recovery.meta

# LIDAR source data (~1GB zips + extracted ASC) — derived inputs, not
# project assets. Docs/CastleLidar.md records the repeatable download
# query if a fresh clone ever needs them re-fetched.
TerrainSources/
